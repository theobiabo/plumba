{
  "name": "plumba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@plumba/dashboard",
    "dev:site": "turbo run dev --filter=site",
    "build": "turbo run build",
    "check": "turbo run check --filter=@plumba/dashboard --filter=@plumba/ui --filter=site --filter=plumba-rust",
    "lint": "turbo run lint --filter=@plumba/dashboard --filter=@plumba/ui --filter=site --filter=plumba-rust",
    "test": "turbo run test --filter=plumba-rust",
    "format": "prettier --write . && turbo run format --filter=plumba-rust",
    "format:check": "prettier --check . && turbo run format --filter=plumba-rust -- --check"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "2.11.10"
  }
}
